# msgpackr-extract is msgpackr's OPTIONAL native accelerator, and msgpackr is a
# dependency of `effect`. This client never encodes msgpack, so building the
# accelerator would put a C++ toolchain in the install for nothing. pnpm refuses
# to guess: an install script it has no decision for FAILS the install. This is
# the decision, recorded — and a NEW script-bearing dependency still fails
# loudly rather than inheriting this one's answer.
allowBuilds[msgpackr-extract]=false
